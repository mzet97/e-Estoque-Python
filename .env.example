# Exemplo de configuração — copie para .env (o .env real NUNCA vai ao git).
# Prefixo EESTOQUE_ + nome da setting (pydantic-settings).

# ---- App ----
EESTOQUE_ENVIRONMENT=development        # development | production | testing
EESTOQUE_SERVER_PORT=8000

# ---- PostgreSQL (paridade do e-Estoque-API .NET) ----
EESTOQUE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/e-estoque
# URL síncrona para Alembic é derivada automaticamente da acima.

# ---- RabbitMQ (publisher de eventos de domínio) ----
EESTOQUE_RABBITMQ_HOST=localhost
EESTOQUE_RABBITMQ_PORT=5672
EESTOQUE_RABBITMQ_USERNAME=dsv
EESTOQUE_RABBITMQ_PASSWORD=dsv@123

# ---- Redis (provisionado por paridade; sem cache no caminho do contrato) ----
EESTOQUE_REDIS_HOST=localhost
EESTOQUE_REDIS_PORT=6379
EESTOQUE_REDIS_PASSWORD=

# ---- Keycloak (realm e-estoque, client confidencial e-estoque-client) ----
EESTOQUE_KEYCLOAK_URL=http://localhost:8080
EESTOQUE_KEYCLOAK_REALM=e-estoque
EESTOQUE_KEYCLOAK_CLIENT_ID=e-estoque-client
EESTOQUE_KEYCLOAK_CLIENT_SECRET=troque-me
EESTOQUE_KEYCLOAK_ISSUER=http://localhost:8080/realms/e-estoque

# ---- Observabilidade ----
# OTLP gRPC (tracing opcional — requer extra [otel]); vazio desliga o tracing.
EESTOQUE_OTLP_ENDPOINT=

# CORS (JSON list)
EESTOQUE_CORS_ORIGINS=["*"]
